# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL
VITE_SUPABASE_URL="https://supabase2.waruna-group.co.id"
# SUPABASE_ANON_KEY: Your Supabase anonymous API key
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
# VITE_TURNSTILE_SITE_KEY: Cloudflare Turnstile SITE key (public, login captcha). Must be set BEFORE
# building the image (Vite inlines it). The SECRET key is NOT stored here: it goes in the Supabase
# project .env as TURNSTILE_SECRET_KEY (verified by Supabase Auth). Leave empty for local dev.
VITE_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY (server-side only, same widget as the site key): used by POST /api/request-otp
# (public /career) to verify the captcha token with Cloudflare. Empty = verification skipped.
TURNSTILE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY: Required for server-side operations (keep private)
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# n8n webhook URLs (server-side only, shared by all users).
# Change here, then restart the server/container.
N8N_WEBHOOK_EMAIL="https://automation.waruna-group.co.id/webhook/..."
N8N_WEBHOOK_WA="https://automation.waruna-group.co.id/webhook/..."
N8N_WEBHOOK_OTP="https://automation.waruna-group.co.id/webhook/..."
N8N_WEBHOOK_CV="https://automation.waruna-group.co.id/webhook/..."
N8N_WEBHOOK_PUBLIC_CV="https://automation.waruna-group.co.id/webhook/..."
N8N_WEBHOOK_SHEET="https://automation.waruna-group.co.id/webhook/..."
N8N_WEBHOOK_EXTERNAL_DATA_DELETE="https://automation.waruna-group.co.id/webhook/..."
N8N_WEBHOOK_AI_ANALYSIS="https://automation.waruna-group.co.id/webhook/..."
N8N_WEBHOOK_AI_PSIKOTES="https://automation.waruna-group.co.id/webhook/..."
N8N_WEBHOOK_AI_INTERVIEW="https://automation.waruna-group.co.id/webhook/..."
